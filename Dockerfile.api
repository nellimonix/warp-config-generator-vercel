FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json ./
RUN npm install --legacy-peer-deps

COPY next.config.mjs tsconfig.json ./
COPY app/api ./app/api
COPY config ./config
COPY lib ./lib
COPY types ./types

ENV DOCKER_API_BUILD=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/config/services ./config/services

USER node
EXPOSE 3000
CMD ["node", "server.js"]
